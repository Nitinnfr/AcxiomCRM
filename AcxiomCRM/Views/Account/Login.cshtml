@model LoginVm
@{Layout="_AuthLayout";ViewData["Title"]="Sign in";}
<div class="auth-logo"><span class="brand-mark"><i class="bi bi-layers-half"></i></span>Acxiom<span style="color:#3267e9">CRM</span></div><h1 class="h4 fw-bold">Welcome back</h1><p class="text-secondary mb-4">Sign in to your sales workspace.</p><form asp-action="Login" method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="mb-3"><label asp-for="Email" class="form-label">Work email</label><input asp-for="Email" class="form-control" placeholder="you@company.com"/><span asp-validation-for="Email" class="text-danger small"></span></div><div class="mb-3"><label asp-for="Password" class="form-label">Password</label><input asp-for="Password" class="form-control" placeholder="Enter your password"/><span asp-validation-for="Password" class="text-danger small"></span></div><div class="form-check mb-4"><input asp-for="RememberMe" class="form-check-input"/><label asp-for="RememberMe" class="form-check-label">Remember me</label></div><button class="btn btn-primary w-100 py-2">Sign in</button></form><p class="small text-center text-secondary mt-4 mb-0">New to AcxiomCRM? <a asp-action="Register">Create an account</a></p>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
