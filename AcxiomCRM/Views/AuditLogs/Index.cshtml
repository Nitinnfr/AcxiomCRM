@model IEnumerable<AcxiomCRM.Models.AuditLog>
@{ViewData["Title"]="Audit Log";}
<div class="mb-4"><h1 class="h3 fw-bold">Audit log</h1><p class="text-secondary">Security and business events recorded by AcxiomCRM.</p></div><form class="card card-body border-0 shadow-sm mb-3" method="get"><div class="row g-2"><div class="col-md-5"><input class="form-control" name="q" value="@ViewBag.Query" placeholder="User, action or module"/></div><div class="col-md-3"><input class="form-control" type="date" name="from" value="@ViewBag.From"/></div><div class="col-md-3"><input class="form-control" type="date" name="to" value="@ViewBag.To"/></div><div class="col-md-1 d-grid"><button class="btn btn-primary">Go</button></div></div></form><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Date/time</th><th>User</th><th>Action</th><th>Module</th><th>Record</th><th>Result</th><th>IP</th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.CreatedDate.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")</td><td>@a.UserName</td><td>@a.Action</td><td>@a.EntityName</td><td>@a.RecordId</td><td>@a.Result</td><td>@a.IpAddress</td></tr>}@if(!Model.Any()){<tr><td colspan="7" class="text-center py-4 text-secondary">No audit entries found.</td></tr>}</tbody></table></div></div>
