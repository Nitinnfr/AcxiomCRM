@model AcxiomCRM.Models.Customer
@{ ViewData["Title"] = "Customer Details"; }
<div class="mb-4"><a asp-action="Index" class="text-decoration-none small">← Back to Customers</a><h1 class="h3 fw-bold mt-2">Customer Details <span class="text-secondary">#@Model.Id</span></h1></div>
<div class="card border-0 shadow-sm"><div class="card-body"><dl class="row"><dt class="col-sm-4 text-secondary">CustomerCode</dt><dd class="col-sm-8">@Model.CustomerCode</dd><dt class="col-sm-4 text-secondary">CustomerName</dt><dd class="col-sm-8">@Model.CustomerName</dd><dt class="col-sm-4 text-secondary">Email</dt><dd class="col-sm-8">@Model.Email</dd><dt class="col-sm-4 text-secondary">Phone</dt><dd class="col-sm-8">@Model.Phone</dd><dt class="col-sm-4 text-secondary">CompanyName</dt><dd class="col-sm-8">@Model.CompanyName</dd><dt class="col-sm-4 text-secondary">Address</dt><dd class="col-sm-8">@Model.Address</dd><dt class="col-sm-4 text-secondary">City</dt><dd class="col-sm-8">@Model.City</dd><dt class="col-sm-4 text-secondary">State</dt><dd class="col-sm-8">@Model.State</dd><dt class="col-sm-4 text-secondary">Status</dt><dd class="col-sm-8">@Model.Status</dd><dt class="col-sm-4 text-secondary">OwnerId</dt><dd class="col-sm-8">@Model.OwnerId</dd><dt class="col-sm-4 text-secondary">Created</dt><dd class="col-sm-8">@Model.CreatedDate</dd></dl><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a> <a class="btn btn-light" asp-action="Index">Back</a></div></div>
