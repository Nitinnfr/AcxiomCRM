@{ViewData["Title"]="Dashboard";}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><div class="text-primary small fw-bold mb-2">OVERVIEW</div><h1 class="h3 fw-bold mb-1">Good to see you, @(User.Identity?.Name?.Split('@')[0])</h1><p class="text-secondary mb-0">Here's what's happening across your sales workspace.</p></div><a asp-controller="Reports" asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-download me-1"></i> View reports</a></div>
<div class="row g-3 mb-4"><div class="col-6 col-xl-3"><div class="kpi-card"><div class="kpi-top">Total Customers <span class="kpi-icon"><i class="bi bi-people"></i></span></div><div class="kpi-value">@ViewBag.Customers</div><div class="kpi-sub">Customers in your scope</div></div></div><div class="col-6 col-xl-3"><div class="kpi-card"><div class="kpi-top">Total Leads <span class="kpi-icon"><i class="bi bi-person-lines-fill"></i></span></div><div class="kpi-value">@ViewBag.Leads</div><div class="kpi-sub">@ViewBag.OpenLeads active leads</div></div></div><div class="col-6 col-xl-3"><div class="kpi-card"><div class="kpi-top">Open Opportunities <span class="kpi-icon"><i class="bi bi-bullseye"></i></span></div><div class="kpi-value">@ViewBag.OpenOpportunities</div><div class="kpi-sub">@ViewBag.Won won · @ViewBag.Lost lost</div></div></div><div class="col-6 col-xl-3"><div class="kpi-card"><div class="kpi-top">Weighted Pipeline <span class="kpi-icon"><i class="bi bi-graph-up-arrow"></i></span></div><div class="kpi-value">@(((decimal)ViewBag.Pipeline).ToString("C0",System.Globalization.CultureInfo.GetCultureInfo("en-IN")))</div><div class="kpi-sub">Expected weighted value</div></div></div></div>
<div class="row g-3 mb-4"><div class="col-xl-7"><div class="card border-0 shadow-sm chart-card"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-3"><div><h2 class="h6 fw-bold mb-1">Lead status</h2><div class="text-secondary small">Distribution by current status</div></div><a asp-controller="Leads" asp-action="Index" class="small text-decoration-none">View leads →</a></div><div class="chart-wrap"><canvas id="leadChart"></canvas></div></div></div></div><div class="col-xl-5"><div class="card border-0 shadow-sm chart-card"><div class="card-body"><div class="mb-3"><h2 class="h6 fw-bold mb-1">Opportunity pipeline</h2><div class="text-secondary small">Deals across sales stages</div></div><div class="chart-wrap"><canvas id="oppChart"></canvas></div></div></div></div></div>
<div class="row g-3"><div class="col-xl-7"><div class="card border-0 shadow-sm"><div class="card-body"><div class="d-flex justify-content-between mb-3"><div><h2 class="h6 fw-bold mb-1">Monthly opportunity activity</h2><div class="text-secondary small">Created opportunities over recent months</div></div></div><div class="chart-wrap"><canvas id="monthlyChart"></canvas></div></div></div></div><div class="col-xl-5"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h6 fw-bold mb-3">Quick actions</h2><a class="quick-action" asp-controller="Customers" asp-action="Create"><span><i class="bi bi-person-plus"></i></span><div><strong>Add a customer</strong><small>Create a new customer record</small></div><i class="bi bi-arrow-up-right ms-auto"></i></a><a class="quick-action" asp-controller="Leads" asp-action="Create"><span><i class="bi bi-lightning"></i></span><div><strong>Capture a lead</strong><small>Add a potential customer</small></div><i class="bi bi-arrow-up-right ms-auto"></i></a><a class="quick-action" asp-controller="FollowUps" asp-action="Create"><span><i class="bi bi-calendar-plus"></i></span><div><strong>Schedule follow-up</strong><small>Plan the next customer touchpoint</small></div><i class="bi bi-arrow-up-right ms-auto"></i></a><a class="quick-action" asp-controller="Opportunities" asp-action="Create"><span><i class="bi bi-bullseye"></i></span><div><strong>Create opportunity</strong><small>Track a potential deal</small></div><i class="bi bi-arrow-up-right ms-auto"></i></a></div></div></div>
@section Scripts { <script src="https://cdn.jsdelivr.net/npm/chart.js"></script><script>
const leadData=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.LeadChart)); const oppData=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.OppChart)); const monthlyData=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Monthly));
const common={responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{usePointStyle:true,boxWidth:7,padding:18,color:'#748096',font:{size:11}}}}};
new Chart(document.getElementById('leadChart'),{type:'doughnut',data:{labels:leadData.map(x=>x.label),datasets:[{data:leadData.map(x=>x.count),backgroundColor:['#3267e9','#59a5fa','#39b98a','#f4b740','#8c72e8','#f07878'],borderWidth:0,hoverOffset:5}]},options:{...common,cutout:'68%'}});
new Chart(document.getElementById('oppChart'),{type:'bar',data:{labels:oppData.map(x=>x.label),datasets:[{label:'Opportunities',data:oppData.map(x=>x.count),backgroundColor:'#4778ed',borderRadius:6,maxBarThickness:34}]},options:{...common,scales:{x:{grid:{display:false},ticks:{color:'#8490a3'}},y:{beginAtZero:true,grid:{color:'#edf0f5'},ticks:{precision:0,color:'#8490a3'}}}}});
new Chart(document.getElementById('monthlyChart'),{type:'line',data:{labels:monthlyData.map(x=>x.label),datasets:[{label:'Created',data:monthlyData.map(x=>x.count),borderColor:'#3267e9',backgroundColor:'#3267e91a',fill:true,tension:.35,pointRadius:4}]},options:{...common,scales:{x:{grid:{display:false},ticks:{color:'#8490a3'}},y:{beginAtZero:true,grid:{color:'#edf0f5'},ticks:{precision:0,color:'#8490a3'}}}}});
</script> }
