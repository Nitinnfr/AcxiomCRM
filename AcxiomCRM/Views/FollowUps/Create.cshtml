@model AcxiomCRM.Models.FollowUp
@{ ViewData["Title"] = "Create Follow-Up"; }
<div class="mb-4"><a asp-action="Index" class="text-decoration-none small"><i class="bi bi-arrow-left"></i> Back to Follow-Ups</a><h1 class="h3 fw-bold mt-2">Create Follow-Up</h1><p class="text-secondary">Enter the details below. Fields are validated before saving.</p></div>
<div class="card border-0 shadow-sm"><div class="card-body p-4"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="CustomerId" class="form-label"></label><input asp-for="CustomerId" type="text" class="form-control" /><span asp-validation-for="CustomerId" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="LeadId" class="form-label"></label><input asp-for="LeadId" type="text" class="form-control" /><span asp-validation-for="LeadId" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="FollowUpDate" class="form-label"></label><input asp-for="FollowUpDate" type="date" class="form-control" value="@Model.FollowUpDate.ToString("yyyy-MM-dd")" /><span asp-validation-for="FollowUpDate" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="FollowUpType" class="form-label"></label><input asp-for="FollowUpType" type="text" class="form-control" /><span asp-validation-for="FollowUpType" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Subject" class="form-label"></label><input asp-for="Subject" type="text" class="form-control" /><span asp-validation-for="Subject" class="text-danger small"></span></div><div class="col-12"><label asp-for="Remarks" class="form-label"></label><textarea asp-for="Remarks" class="form-control" rows="3"></textarea><span asp-validation-for="Remarks" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Status" class="form-label"></label><input asp-for="Status" type="text" class="form-control" /><span asp-validation-for="Status" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="AssignedTo" class="form-label"></label><input asp-for="AssignedTo" type="text" class="form-control" /><span asp-validation-for="AssignedTo" class="text-danger small"></span></div></div><div class="mt-4 d-flex gap-2"><button class="btn btn-primary" type="submit">Save Follow-Up</button><a class="btn btn-light" asp-action="Index">Cancel</a></div></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
