@model AcxiomCRM.Models.Lead
@{ ViewData["Title"] = "Create Lead"; }
<div class="mb-4"><a asp-action="Index" class="text-decoration-none small"><i class="bi bi-arrow-left"></i> Back to Leads</a><h1 class="h3 fw-bold mt-2">Create Lead</h1><p class="text-secondary">Enter the details below. Fields are validated before saving.</p></div>
<div class="card border-0 shadow-sm"><div class="card-body p-4"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="LeadCode" class="form-label"></label><input asp-for="LeadCode" type="text" class="form-control" /><span asp-validation-for="LeadCode" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="LeadName" class="form-label"></label><input asp-for="LeadName" type="text" class="form-control" /><span asp-validation-for="LeadName" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" type="email" class="form-control" /><span asp-validation-for="Email" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" type="text" class="form-control" /><span asp-validation-for="Phone" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="CompanyName" class="form-label"></label><input asp-for="CompanyName" type="text" class="form-control" /><span asp-validation-for="CompanyName" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Source" class="form-label"></label><input asp-for="Source" type="text" class="form-control" /><span asp-validation-for="Source" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Status" class="form-label"></label><input asp-for="Status" type="text" class="form-control" /><span asp-validation-for="Status" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Priority" class="form-label"></label><input asp-for="Priority" type="text" class="form-control" /><span asp-validation-for="Priority" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="ExpectedValue" class="form-label"></label><input asp-for="ExpectedValue" type="number" class="form-control" step="0.01" /><span asp-validation-for="ExpectedValue" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="AssignedTo" class="form-label"></label><input asp-for="AssignedTo" type="text" class="form-control" /><span asp-validation-for="AssignedTo" class="text-danger small"></span></div></div><div class="mt-4 d-flex gap-2"><button class="btn btn-primary" type="submit">Save Lead</button><a class="btn btn-light" asp-action="Index">Cancel</a></div></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
