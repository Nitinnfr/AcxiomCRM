@model AcxiomCRM.Models.Lead
@{ ViewData["Title"] = "Lead Details"; }
<div class="mb-4"><a asp-action="Index" class="text-decoration-none small">← Back to Leads</a><h1 class="h3 fw-bold mt-2">Lead Details <span class="text-secondary">#@Model.Id</span></h1></div>
<div class="card border-0 shadow-sm"><div class="card-body"><dl class="row"><dt class="col-sm-4 text-secondary">LeadCode</dt><dd class="col-sm-8">@Model.LeadCode</dd><dt class="col-sm-4 text-secondary">LeadName</dt><dd class="col-sm-8">@Model.LeadName</dd><dt class="col-sm-4 text-secondary">Email</dt><dd class="col-sm-8">@Model.Email</dd><dt class="col-sm-4 text-secondary">Phone</dt><dd class="col-sm-8">@Model.Phone</dd><dt class="col-sm-4 text-secondary">CompanyName</dt><dd class="col-sm-8">@Model.CompanyName</dd><dt class="col-sm-4 text-secondary">Source</dt><dd class="col-sm-8">@Model.Source</dd><dt class="col-sm-4 text-secondary">Status</dt><dd class="col-sm-8">@Model.Status</dd><dt class="col-sm-4 text-secondary">Priority</dt><dd class="col-sm-8">@Model.Priority</dd><dt class="col-sm-4 text-secondary">ExpectedValue</dt><dd class="col-sm-8">@Model.ExpectedValue</dd><dt class="col-sm-4 text-secondary">AssignedTo</dt><dd class="col-sm-8">@Model.AssignedTo</dd><dt class="col-sm-4 text-secondary">Created</dt><dd class="col-sm-8">@Model.CreatedDate</dd></dl><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a> <a class="btn btn-light" asp-action="Index">Back</a></div></div>
