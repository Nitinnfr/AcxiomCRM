@model AcxiomCRM.Models.Opportunity
@{ ViewData["Title"] = "Create Opportunity"; }
<div class="mb-4"><a asp-action="Index" class="text-decoration-none small"><i class="bi bi-arrow-left"></i> Back to Opportunitys</a><h1 class="h3 fw-bold mt-2">Create Opportunity</h1><p class="text-secondary">Enter the details below. Fields are validated before saving.</p></div>
<div class="card border-0 shadow-sm"><div class="card-body p-4"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="OpportunityName" class="form-label"></label><input asp-for="OpportunityName" type="text" class="form-control" /><span asp-validation-for="OpportunityName" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="CustomerId" class="form-label"></label><input asp-for="CustomerId" type="text" class="form-control" /><span asp-validation-for="CustomerId" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="LeadId" class="form-label"></label><input asp-for="LeadId" type="text" class="form-control" /><span asp-validation-for="LeadId" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Amount" class="form-label"></label><input asp-for="Amount" type="number" class="form-control" step="0.01" /><span asp-validation-for="Amount" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Stage" class="form-label"></label><input asp-for="Stage" type="text" class="form-control" /><span asp-validation-for="Stage" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Probability" class="form-label"></label><input asp-for="Probability" type="number" class="form-control" min="0" max="100" /><span asp-validation-for="Probability" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="ExpectedCloseDate" class="form-label"></label><input asp-for="ExpectedCloseDate" type="date" class="form-control" value="@Model.ExpectedCloseDate.ToString("yyyy-MM-dd")" /><span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Status" class="form-label"></label><input asp-for="Status" type="text" class="form-control" /><span asp-validation-for="Status" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="AssignedTo" class="form-label"></label><input asp-for="AssignedTo" type="text" class="form-control" /><span asp-validation-for="AssignedTo" class="text-danger small"></span></div></div><div class="mt-4 d-flex gap-2"><button class="btn btn-primary" type="submit">Save Opportunity</button><a class="btn btn-light" asp-action="Index">Cancel</a></div></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
