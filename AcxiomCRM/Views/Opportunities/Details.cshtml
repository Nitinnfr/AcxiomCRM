@model AcxiomCRM.Models.Opportunity
@{ ViewData["Title"] = "Opportunity Details"; }
<div class="mb-4"><a asp-action="Index" class="text-decoration-none small">← Back to Opportunitys</a><h1 class="h3 fw-bold mt-2">Opportunity Details <span class="text-secondary">#@Model.Id</span></h1></div>
<div class="card border-0 shadow-sm"><div class="card-body"><dl class="row"><dt class="col-sm-4 text-secondary">OpportunityName</dt><dd class="col-sm-8">@Model.OpportunityName</dd><dt class="col-sm-4 text-secondary">CustomerId</dt><dd class="col-sm-8">@Model.CustomerId</dd><dt class="col-sm-4 text-secondary">LeadId</dt><dd class="col-sm-8">@Model.LeadId</dd><dt class="col-sm-4 text-secondary">Amount</dt><dd class="col-sm-8">@Model.Amount</dd><dt class="col-sm-4 text-secondary">Stage</dt><dd class="col-sm-8">@Model.Stage</dd><dt class="col-sm-4 text-secondary">Probability</dt><dd class="col-sm-8">@Model.Probability</dd><dt class="col-sm-4 text-secondary">ExpectedCloseDate</dt><dd class="col-sm-8">@Model.ExpectedCloseDate</dd><dt class="col-sm-4 text-secondary">Status</dt><dd class="col-sm-8">@Model.Status</dd><dt class="col-sm-4 text-secondary">AssignedTo</dt><dd class="col-sm-8">@Model.AssignedTo</dd><dt class="col-sm-4 text-secondary">Created</dt><dd class="col-sm-8">@Model.CreatedDate</dd></dl><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a> <a class="btn btn-light" asp-action="Index">Back</a></div></div>
