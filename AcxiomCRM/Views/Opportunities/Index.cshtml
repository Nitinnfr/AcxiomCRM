@model IEnumerable<AcxiomCRM.Models.Opportunity>
@{ ViewData["Title"] = "Opportunity Management"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 fw-bold mb-1">Opportunity Management</h1><p class="text-secondary mb-0">Manage and track your opportunity records.</p></div><a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i> Add Opportunity</a></div>
@if(TempData["Success"]!=null){<div class="alert alert-success">@TempData["Success"]</div>} @if(TempData["Error"]!=null){<div class="alert alert-danger">@TempData["Error"]</div>}
<form method="get" class="card card-body border-0 shadow-sm mb-3"><div class="row g-2"><div class="col-md-8"><input class="form-control" name="q" value="@ViewBag.Query" placeholder="Search opportunity..." /></div><div class="col-md-2"><input class="form-control" name="status" value="@ViewBag.Status" placeholder="Status" /></div><div class="col-md-2 d-grid"><button class="btn btn-outline-primary">Search</button></div></div></form>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>ID</th><th>OpportunityName</th><th>CustomerId</th><th>LeadId</th><th>Amount</th><th>Stage</th><th>Created</th><th class="text-end">Actions</th></tr></thead><tbody>
@foreach(var item in Model){<tr><td class="text-secondary">#@item.Id</td><td>@item.OpportunityName</td><td>@item.CustomerId</td><td>@item.LeadId</td><td>@item.Amount</td><td>@item.Stage</td><td>@item.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")</td><td class="text-end text-nowrap"><a class="btn btn-sm btn-light" asp-action="Details" asp-route-id="@item.Id">View</a> <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a> <form class="d-inline" asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Delete or deactivate this record?')"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>}
@if(!Model.Any()){<tr><td colspan="9" class="text-center py-5 text-secondary">No records found. Add your first record to get started.</td></tr>}
</tbody></table></div></div>
<div class="d-flex justify-content-between align-items-center mt-3 text-secondary small"><span>Page @ViewBag.Page of @Math.Max(1,(int)ViewBag.Pages)</span><div><a class="btn btn-sm btn-outline-secondary" asp-route-page="@(Math.Max(1,(int)ViewBag.Page-1))" asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status">Previous</a> <a class="btn btn-sm btn-outline-secondary" asp-route-page="@((int)ViewBag.Page+1)" asp-route-q="@ViewBag.Query" asp-route-status="@ViewBag.Status">Next</a></div></div>
