@{ViewData["Title"]="Reports";}
<div class="mb-4"><h1 class="h3 fw-bold mb-1">Reports & insights</h1><p class="text-secondary mb-0">Explore your CRM data and export useful summaries.</p></div><div class="row g-3"><div class="col-md-6 col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><span class="kpi-icon mb-3"><i class="bi bi-people"></i></span><h2 class="h6 fw-bold">Customer report</h2><p class="text-secondary small">Customer details, status, company and creation date.</p><a class="btn btn-outline-primary" asp-action="CustomersCsv">Export CSV</a></div></div></div><div class="col-md-6 col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><span class="kpi-icon mb-3"><i class="bi bi-funnel"></i></span><h2 class="h6 fw-bold">Lead report</h2><p class="text-secondary small">Review lead sources, statuses and expected values.</p><a class="btn btn-outline-primary" asp-controller="Leads" asp-action="Index">View leads</a></div></div></div><div class="col-md-6 col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><span class="kpi-icon mb-3"><i class="bi bi-bullseye"></i></span><h2 class="h6 fw-bold">Opportunity pipeline</h2><p class="text-secondary small">Review deal stages, amounts, probabilities and close dates.</p><a class="btn btn-outline-primary" asp-controller="Opportunities" asp-action="Index">View opportunities</a></div></div></div><div class="col-md-6 col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><span class="kpi-icon mb-3"><i class="bi bi-calendar-check"></i></span><h2 class="h6 fw-bold">Follow-up report</h2><p class="text-secondary small">Review planned, completed, missed and overdue follow-ups.</p><a class="btn btn-outline-primary" asp-controller="FollowUps" asp-action="Index">View follow-ups</a></div></div></div><div class="col-md-6 col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><span class="kpi-icon mb-3"><i class="bi bi-list-task"></i></span><h2 class="h6 fw-bold">Activity report</h2><p class="text-secondary small">Review customer calls, meetings, emails and tasks.</p><a class="btn btn-outline-primary" asp-controller="Activities" asp-action="Index">View activities</a></div></div></div><div class="col-md-6 col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><span class="kpi-icon mb-3"><i class="bi bi-shield-check"></i></span><h2 class="h6 fw-bold">Audit report</h2><p class="text-secondary small">Review security events and important business changes.</p>@if(User.IsInRole("Admin")){<a class="btn btn-outline-primary" asp-controller="AuditLogs" asp-action="Index">View audit log</a>}else{<span class="text-secondary small">Administrator access required</span>}</div></div></div></div>
