<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - AcxiomCRM</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"><link href="~/css/site.css" rel="stylesheet" /></head><body><div class="app-shell">
@if(User.Identity?.IsAuthenticated==true){<aside class="sidebar"><a class="brand" asp-controller="Dashboard" asp-action="Index"><span class="brand-mark"><i class="bi bi-layers-half"></i></span><span>Acxiom<span class="brand-light">CRM</span><small>SALES WORKSPACE</small></span></a><div class="nav-label">WORKSPACE</div><a class="side-link" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2"></i> Dashboard</a><a class="side-link" asp-controller="Customers" asp-action="Index"><i class="bi bi-people"></i> Customers</a><a class="side-link" asp-controller="Leads" asp-action="Index"><i class="bi bi-person-lines-fill"></i> Leads</a><a class="side-link" asp-controller="Opportunities" asp-action="Index"><i class="bi bi-bullseye"></i> Opportunities</a><a class="side-link" asp-controller="FollowUps" asp-action="Index"><i class="bi bi-calendar-check"></i> Follow-ups</a><a class="side-link" asp-controller="Activities" asp-action="Index"><i class="bi bi-list-task"></i> Activities</a><div class="nav-label mt-4">INSIGHTS & ADMIN</div><a class="side-link" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart"></i> Reports</a>@if(User.IsInRole("Admin")){<a class="side-link" asp-controller="Users" asp-action="Index"><i class="bi bi-person-gear"></i> Users & Roles</a><a class="side-link" asp-controller="AuditLogs" asp-action="Index"><i class="bi bi-shield-check"></i> Audit Log</a>}<div class="sidebar-bottom"><div class="avatar">@(User.Identity.Name?.Substring(0,1).ToUpper())</div><div class="user-label"><strong>@User.Identity.Name</strong><small>@(User.IsInRole("Admin")?"Administrator":User.IsInRole("Manager")?"Manager":"Sales Executive")</small></div><form asp-controller="Account" asp-action="Logout" method="post"><button class="icon-btn" title="Sign out"><i class="bi bi-box-arrow-right"></i></button></form></div></aside>}
<main class="main-area"><header class="topbar"><div class="d-flex align-items-center gap-2"><span class="mobile-brand">AcxiomCRM</span><span class="breadcrumb-text">Workspace <i class="bi bi-chevron-right mx-1"></i> @ViewData["Title"]</span></div><div class="d-flex align-items-center gap-3"><span class="today-label"><i class="bi bi-calendar3 me-1"></i> @DateTime.Today.ToString("ddd, dd MMM yyyy")</span>@if(User.Identity?.IsAuthenticated==true){<span class="top-avatar">@(User.Identity.Name?.Substring(0,1).ToUpper())</span>}</div></header><section class="page-content">@RenderBody()</section><footer class="app-footer">© @DateTime.Today.Year AcxiomCRM <span>Customer relationships, made clearer.</span></footer></main></div><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="https://code.jquery.com/jquery-3.7.1.min.js"></script><script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script><script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script><script src="~/js/site.js"></script>@await RenderSectionAsync("Scripts", required:false)</body></html>
