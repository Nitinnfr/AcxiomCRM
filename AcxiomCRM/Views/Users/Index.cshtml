@model IEnumerable<AcxiomCRM.Models.ApplicationUser>
@{ViewData["Title"]="Users & Roles";}
<div class="mb-4"><h1 class="h3 fw-bold">Users & roles</h1><p class="text-secondary">Manage account activation and review user access.</p></div><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Name</th><th>Email</th><th>Status</th><th>Created</th><th>Action</th></tr></thead><tbody>@foreach(var u in Model){<tr><td class="fw-semibold">@u.FullName</td><td>@u.Email</td><td><span class="badge rounded-pill @(u.IsActive?"text-bg-success":"text-bg-secondary")">@(u.IsActive?"Active":"Inactive")</span></td><td>@u.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")</td><td><form asp-action="Toggle" method="post"><input type="hidden" name="id" value="@u.Id"/><button class="btn btn-sm btn-outline-primary">@(u.IsActive?"Deactivate":"Activate")</button></form></td></tr>}</tbody></table></div></div><p class="small text-secondary mt-3">New self-registered accounts are assigned the SalesExecutive role. Use the Identity administration workflow for additional role changes.</p>
